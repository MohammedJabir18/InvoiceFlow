# ==============================================================================
# InvoiceFlow SaaS — Environment Variables Template
# All secrets and credentials below are non-production placeholders.
# DO NOT commit real API keys, secrets, or production credentials to git.
# ==============================================================================

# Application Environment
NODE_ENV=development
PORT=3001
HOST=127.0.0.1
CORS_ORIGIN=http://localhost:5173

# Database Connections (Local PostgreSQL 17)
# Restricted runtime role (NOSUPERUSER, NOBYPASSRLS) used by API server
DATABASE_URL=postgresql://invoiceflow_app:app_dev_password@127.0.0.1:5434/invoiceflow_saas

# Migration role (Schema Owner, DDL) used exclusively for migrations and tests setup
MIGRATOR_DATABASE_URL=postgresql://invoiceflow_migrator:migrator_dev_password@127.0.0.1:5434/invoiceflow_saas

# Supabase Auth Configuration
# Public project URL (used for issuer validation 'iss')
SUPABASE_URL=http://127.0.0.1:54321

# Client anon key (safe for browser exposure)
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJyZWYiOiJsb2NhbCIsInJvbGUiOiJhbm9uIn0.placeholder_anon_key

# Supabase JWT Secret (Minimum 32 characters, used by API server to verify HS256 tokens)
# In production with asymmetric keys, configure SUPABASE_JWKS_URL instead
SUPABASE_JWT_SECRET=super_secret_local_dev_jwt_secret_min_32_chars_long_123456
